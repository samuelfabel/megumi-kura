# Megumi Kura — example environment variables
# Copy to .env for local development. Never commit real secrets.

# HTTP
MK_HTTP_ADDR=:8080
MK_STATIC_DIR=web/dist

# PostgreSQL
MK_DATABASE_URL=postgres://megumi:megumi@localhost:5432/megumi_kura?sslmode=disable

# Session signing secret (change in any non-local environment)
MK_SESSION_SECRET=change-me-dev-only-secret

# Optional overrides for site branding / locale
# MK_SITE_NAME=Megumi Kura
# MK_SITE_DESCRIPTION=Community Food Management
# MK_DEFAULT_LOCALE=pt-BR
# MK_THEME_PRIMARY=#2E7D32
# MK_THEME_SECONDARY=#795548
# MK_THEME_ACCENT=#F9A825

# Allow negative stock (default: false)
# MK_ALLOW_NEGATIVE_STOCK=false
